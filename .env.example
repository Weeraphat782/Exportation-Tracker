# Copy to .env.local — do not commit secrets

# App
NEXT_PUBLIC_SITE_URL=https://cargo.omgexp.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local: redirect marketing HTML to Astro dev server
NEXT_PUBLIC_MARKETING_URL=http://localhost:4321

# CMS → rebuild Astro marketing site on GitHub Actions (see web/docs/CMS-REBUILD.md)
MARKETING_GITHUB_PAT=
MARKETING_GITHUB_REPO=Weeraphat782/CargoWebsiteAstro
MARKETING_GITHUB_WORKFLOW=deploy-marketing.yml
MARKETING_SITE_ORIGIN=https://www.omgcargo.tech

# GA dashboard: marketing traffic on new domain (default www.omgcargo.tech)
# MARKETING_GA_HOSTNAME=www.omgcargo.tech

# Email notifications (Resend) — verify omgcargo.tech at resend.com/domains first
RESEND_API_KEY=
RESEND_FROM_EMAIL=OMG Cargo <noreply@omgcargo.tech>
CONTACT_NOTIFY_EMAIL=cargo@omgexp.com
